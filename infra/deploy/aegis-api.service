# systemd unit for the AegisAI API.
#   sudo cp infra/deploy/aegis-api.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now aegis-api

[Unit]
Description=AegisAI API
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
User=aegis
Group=aegis
WorkingDirectory=/srv/aegisai/app
EnvironmentFile=/srv/aegisai/app/.env

# Bound to loopback on purpose: Caddy is the only thing that should be able to
# reach uvicorn. Binding 0.0.0.0 would expose the API on port 8000 without TLS
# alongside the properly terminated one, which is the kind of thing nobody
# notices until a scanner does.
#
# --proxy-headers with --forwarded-allow-ips lets uvicorn trust the
# X-Forwarded-For Caddy sets, so the audit log and the per-IP rate limiter
# record the visitor's address rather than 127.0.0.1 for every request.
ExecStart=/srv/aegisai/app/.venv/bin/uvicorn services.api.main:app \
    --host 127.0.0.1 --port 8000 \
    --workers 2 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=always
RestartSec=3

# The lifespan hook warms the classifier, the retriever and every agent before
# the first request. On a machine with the checkpoint that is tens of seconds.
TimeoutStartSec=300

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
