# AegisAI — production environment.
#
#   cp infra/deploy/env.production.example /srv/aegisai/app/.env
#   chmod 600 /srv/aegisai/app/.env
#   chown aegis:aegis /srv/aegisai/app/.env
#
# systemd reads this file directly (EnvironmentFile=), so it is plain
# `KEY=value` with no `export`, no quotes needed around ordinary values, and no
# shell expansion — `$` is literal.
#
# Everything in the top block MUST be set. Everything below it has a default
# that is correct for a small deployment.

# ── REQUIRED ───────────────────────────────────────────────────────────────

# The signing key for session tokens. Without it the API generates a new key
# every restart, which signs every existing session out. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
AEGIS_SECRET_KEY=

# Turn authentication ON. This is the single most important line in the file.
# Left at the default the API acts as the seeded owner for any request with no
# token — which is the right behaviour for a laptop demo and an open door on
# the public internet. Setting it also stops the demo roster from being seeded
# at all, so a real deployment ships no known-password accounts.
AEGIS_AUTH=1

# The database. Create the role and database first; see docs/DEPLOYMENT.md.
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME@127.0.0.1:5432/aegis

# Where uploaded evidence bytes are written. Set this whenever DATABASE_URL is
# set, or a case outlives its own screenshots — /api/health raises
# `blobs:ephemeral` for exactly that mismatch.
AEGIS_EVIDENCE_DIR=/srv/aegisai/evidence

# The first administrator. Change the password before the first boot: this
# account is created on startup and these are the credentials it gets.
AEGIS_ADMIN_EMAIL=you@yourdomain.in
AEGIS_ADMIN_PASSWORD=

# ── Same-origin deployment ─────────────────────────────────────────────────
# With Caddy serving the SPA and proxying /api on one host, the browser never
# makes a cross-origin request and this can stay empty. Set it only if you
# split the SPA onto a different host — then it must list that host's origin,
# comma-separated, scheme included.
# AEGIS_CORS_ORIGINS=https://aegisai.in

# ── Optional ───────────────────────────────────────────────────────────────

# Session lifetime, seconds. Sessions are revocable server-side, so signing out
# ends one immediately regardless of this.
# AEGIS_TOKEN_TTL=43200

# Public sign-up. A sign-up always creates a CITIZEN — the role is never taken
# from the request — so this is an abuse switch, not a privilege one. Turn it
# off if you provision every account by hand.
# AEGIS_SIGNUP=true

# NEVER set AEGIS_DEV_PASSWORD_RESET in production. It returns password-reset
# tokens in the HTTP response. The API refuses it while AEGIS_AUTH=1 anyway,
# which is the belt to this brace.

# The fine-tuned classifier. Absent, the API serves the lexical model and says
# so on /api/health (`clf:lexical_fallback`). See docs/DEPLOYMENT.md step 7.
# AEGIS_ARTIFACTS=/srv/aegisai/artifacts

# The async job system. Leave the queue on: with no Redis reachable the graph
# runs in the API process and reports `execution.mode: in-process`, which is a
# correct and slower deployment rather than a broken one.
# AEGIS_QUEUE=true
# AEGIS_REDIS_HOST=127.0.0.1
# AEGIS_REDIS_PORT=6379

# LLM explanations. Optional — with no backend the templated explainer is used
# and every verdict still carries its citations. The LLM never scores anything.
# AEGIS_LLM=gemini
# GEMINI_API_KEY=
