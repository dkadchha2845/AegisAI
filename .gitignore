# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ── Secrets ────────────────────────────────────────────────────────────────
# .env holds real API keys. .env.example is committed and is the template.
.env
.env.local

# ── Node ───────────────────────────────────────────────────────────────────
node_modules/
.next/
dist/

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Editor ─────────────────────────────────────────────────────────────────
.claude/settings.local.json
.vscode/
.idea/

# ── ML artifacts ───────────────────────────────────────────────────────────
# The MuRIL checkpoint is ~950MB of weights plus ~2.6GB of optimiser state.
# It is NOT committed, and nothing *breaks* without it: load_classifier()
# reports "no checkpoint exported" and serves the lexical classifier — but that
# is a measurably worse mode, not an equivalent one (macro-F1 0.375 vs 0.767 on
# held-out archetypes), and /api/health says so.
#
# Reproduce it with `.venv/bin/python ml/training/train.py` — the corpus that
# produces it IS committed, so the checkpoint is regenerable rather than lost.
ml/artifacts/*
ml/artifacts/_train/
ml/models/

# The measurement record is small and load-bearing: backend_comparison.json is
# what gates promotion of the checkpoint, and /api/health reads it.
!ml/artifacts/backend_comparison.json
# The promotion record: measured scores bound to a SHA256 fingerprint of the
# exact weights they describe. Tracked because it is the answer to "are these
# numbers about the model I have?" — see ml/evaluation/manifest.py.
!ml/artifacts/checkpoint_manifest.json
# stage-classifier/metrics.json is deliberately NOT tracked. train.py writes it
# and nothing ever reads it, so it silently went stale: it still claims macro-F1
# 0.269 for a checkpoint that measures 0.767. A write-only number with nothing
# tying it to a model is exactly the trap the manifest exists to close.

# tsc -b incremental build cache
*.tsbuildinfo

# Generated status report — regenerate from STATUS.md, do not commit
AegisAI-status-report.pdf

# Temporary subsampled training splits (regenerated on demand)
ml/data/processed/*_fast.jsonl

# Runtime SQLite database (persistent store; regenerated + reseeded on boot)
aegis.db
aegis.db-journal
aegis.db-wal
aegis.db-shm
.preview/

# Build metadata regenerated by `pip install -e`. Tracking it meant every
# editable reinstall showed up as a source change — the licence commit that
# added one line to pyproject.toml also carried a PKG-INFO diff, which is how it
# was noticed. Untracked alongside `.coverage`, same reason: a file the build
# rewrites is not a file a reviewer should be reading.
*.egg-info/
*.egg-info

# Coverage output. `.coverage` is a binary SQLite database rewritten by every
# test run, so tracking it put a churning blob in every diff and told a reviewer
# nothing. Untracked in task 0.7; the number that matters is the one the
# coverage gate prints, and CI recomputes it.
.coverage
.coverage.*
htmlcov/
coverage.xml
