# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# ── Secrets ────────────────────────────────────────────────────────────────
# .env holds real API keys. .env.example is committed and is the template.
.env
.env.local

# ── Node ───────────────────────────────────────────────────────────────────
node_modules/
.next/
dist/

# ── OS ─────────────────────────────────────────────────────────────────────
.DS_Store

# ── Editor ─────────────────────────────────────────────────────────────────
.claude/settings.local.json
.vscode/
.idea/

# ── ML artifacts ───────────────────────────────────────────────────────────
# The MuRIL checkpoint is ~950MB of weights plus ~2.6GB of optimiser state.
# It is NOT committed, and nothing breaks without it: load_classifier() reports
# "no checkpoint exported" and serves the lexical classifier, which currently
# scores *better* on held-out archetypes anyway (see README).
#
# Reproduce it with `.venv/bin/python ml/train.py` — the corpus that produces
# it IS committed, so the checkpoint is regenerable rather than lost.
ml/artifacts/*
ml/artifacts/_train/
ml/models/

# The measurement record is small and load-bearing: backend_comparison.json is
# what gates promotion of the checkpoint, and /api/health reads it.
!ml/artifacts/backend_comparison.json
!ml/artifacts/stage-classifier/
ml/artifacts/stage-classifier/*
!ml/artifacts/stage-classifier/metrics.json

# tsc -b incremental build cache
*.tsbuildinfo

# Generated status report — regenerate from STATUS.md, do not commit
AegisAI-status-report.pdf

# Temporary subsampled training splits (regenerated on demand)
ml/data/processed/*_fast.jsonl

# Runtime SQLite database (persistent store; regenerated + reseeded on boot)
aegis.db
aegis.db-journal
aegis.db-wal
aegis.db-shm
.preview/
