# ── Dataset + coach-library generation (offline, one-time, free) ────────────
# Pick ONE backend. Nothing here bills during the hackathon.

AEGIS_LLM=gemini

# Option A — Gemini free tier. Google account, no card.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option B — fully offline. No key needed.
#   brew install ollama && ollama serve && ollama pull qwen2.5:7b-instruct
# AEGIS_LLM=ollama

# Optional: override the backend's default model
# AEGIS_MODEL=

# ── Persistence ────────────────────────────────────────────────────────────
# Leave unset for the zero-setup ephemeral demo (reported as db:ephemeral).
# Point it at a file to persist saved cases, users, and the audit log across
# restarts — this clears the db:ephemeral degradation:
DATABASE_URL=sqlite:///aegis.db
#   or Postgres:  DATABASE_URL=postgresql+psycopg://user:pass@host/dbname

# ── Auth ───────────────────────────────────────────────────────────────────
# Stable HMAC signing key so session tokens survive an API restart. Generate
# one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset in dev and a per-process key is used (you get logged out on reload).
# AEGIS_SECRET_KEY=
# Require a bearer token on protected routes (default: open demo mode):
# AEGIS_AUTH=1
# The seeded platform-owner account (change the password for anything real):
# AEGIS_ADMIN_EMAIL=admin@aegis.local
# AEGIS_ADMIN_PASSWORD=changeme

# ── Runtime ────────────────────────────────────────────────────────────────
# Dev and rehearsal use local faster-whisper. Sarvam is swapped in only for
# the live run, and only if the free credits are intact.
SARVAM_API_KEY=

# ── Backing stores (infra/compose/dev.yml) ──────────────────────────────────
# Host/port only — these are liveness-probe targets for /api/health, not
# connection strings, so nothing here is a credential. Every one is optional:
# with the stack down the API uses SQLite, in-process NetworkX and the in-house
# vector store, and says so under `infrastructure` on /api/health.
# Override a port if you already run one of these locally.
# AEGIS_PG_HOST=127.0.0.1
# AEGIS_PG_PORT=5432
# AEGIS_NEO4J_HOST=127.0.0.1
# AEGIS_NEO4J_BOLT_PORT=7687
# AEGIS_QDRANT_HOST=127.0.0.1
# AEGIS_QDRANT_PORT=6333
# AEGIS_REDIS_HOST=127.0.0.1
# AEGIS_REDIS_PORT=6379

# Credentials used by the compose stack itself (dev only — never production).
# AEGIS_PG_USER=aegis
# AEGIS_PG_PASSWORD=aegis_dev_only
# AEGIS_PG_DB=aegis
# AEGIS_NEO4J_USER=neo4j
# AEGIS_NEO4J_PASSWORD=aegis_dev_only
