# ── Dataset + coach-library generation (offline, one-time, free) ────────────
# Pick ONE backend. Nothing here bills during the hackathon.

AEGIS_LLM=gemini

# Option A — Gemini free tier. Google account, no card.
#   https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Option B — fully offline. No key needed.
#   brew install ollama && ollama serve && ollama pull qwen2.5:7b-instruct
# AEGIS_LLM=ollama

# Optional: override the backend's default model
# AEGIS_MODEL=

# ── Persistence ────────────────────────────────────────────────────────────
# Leave unset for the zero-setup ephemeral demo (reported as db:ephemeral).
# Point it at a file to persist saved cases, users, and the audit log across
# restarts — this clears the db:ephemeral degradation:
DATABASE_URL=sqlite:///aegis.db
#   or Postgres:  DATABASE_URL=postgresql+psycopg://user:pass@host/dbname

# Where uploaded evidence bytes are written (task 1.6). Unset means a
# per-process temp directory that is deleted at exit, which is right for the
# zero-setup demo and wrong the moment DATABASE_URL is set: the case would
# outlive its own screenshots. /api/health reports `blobs:ephemeral` for exactly
# that combination, so the mismatch is visible rather than discovered later.
# AEGIS_EVIDENCE_DIR=./var/evidence

# ── Auth ───────────────────────────────────────────────────────────────────
# Stable HMAC signing key so session tokens survive an API restart. Generate
# one with:  python -c "import secrets; print(secrets.token_hex(32))"
# Leave unset in dev and a per-process key is used (you get logged out on reload).
# AEGIS_SECRET_KEY=
# Require a bearer token on protected routes (default: open demo mode):
# AEGIS_AUTH=1
# The seeded platform-owner account (change the password for anything real):
# AEGIS_ADMIN_EMAIL=admin@aegis.local
# AEGIS_ADMIN_PASSWORD=changeme
# How long an issued session token is accepted for, in seconds (default 12h).
# Sessions are revocable server-side, so signing out ends one immediately
# regardless of this.
# AEGIS_TOKEN_TTL=43200
# Shared password for the seeded demo roster (citizen/police/researcher/
# analyst/viewer/supervisor). Open mode only — none of those accounts are
# created when AEGIS_AUTH=1.
# AEGIS_DEMO_PASSWORD=changeme
# Accept public sign-ups. A sign-up always creates a CITIZEN; the role is never
# taken from the request, so this is an abuse switch, not a privilege one.
# AEGIS_SIGNUP=true
# How long a password-reset token stays redeemable, in seconds.
# AEGIS_PASSWORD_RESET_TTL=3600
# Return the reset token in the /api/auth/password/forgot response instead of
# only printing it to the API log. There is no mail transport configured here,
# so one of the two is how a reset gets completed at all — and handing the token
# back over HTTP is exactly what you must never do in production, which is why
# this is off by default and refused outright when AEGIS_AUTH=1.
# AEGIS_DEV_PASSWORD_RESET=1

# ── Runtime ────────────────────────────────────────────────────────────────
# Dev and rehearsal use local faster-whisper. Sarvam is swapped in only for
# the live run, and only if the free credits are intact.

# ── Backing stores (infra/compose/dev.yml) ──────────────────────────────────
# Host/port only — these are liveness-probe targets for /api/health, not
# connection strings, so nothing here is a credential. Every one is optional:
# with the stack down the API uses SQLite, in-process NetworkX and the in-house
# vector store, and says so under `infrastructure` on /api/health.
# Override a port if you already run one of these locally.
# AEGIS_PG_HOST=127.0.0.1
# AEGIS_PG_PORT=5432
# AEGIS_NEO4J_HOST=127.0.0.1
# AEGIS_NEO4J_BOLT_PORT=7687
# AEGIS_QDRANT_HOST=127.0.0.1
# AEGIS_QDRANT_PORT=6333
# AEGIS_REDIS_HOST=127.0.0.1
# AEGIS_REDIS_PORT=6379
# AEGIS_REDIS_DB=0
# A full broker URL instead of the host/port/db above — for a Redis that needs
# a password or TLS. This is the one variable here that can carry a credential,
# which is why /api/health prints it with the userinfo stripped.
# AEGIS_REDIS_URL=redis://:password@redis.internal:6379/0

# Credentials used by the compose stack itself (dev only — never production).
# AEGIS_PG_USER=aegis
# AEGIS_PG_PASSWORD=aegis_dev_only
# AEGIS_PG_DB=aegis
# AEGIS_NEO4J_USER=neo4j
# AEGIS_NEO4J_PASSWORD=aegis_dev_only

# ── Everything else, with its default ───────────────────────────────────────
# All optional. Each shows the value used when unset, so this file doubles as
# the settings reference. Old PRESAGE_* spellings are still accepted for every
# AEGIS_* name below.

# Retrieval: sentence-transformers if installed, else deterministic BM25.
# AEGIS_DENSE_RAG=true
# OCR backend: tesseract | easyocr | none
# AEGIS_OCR=tesseract
# Local LLM host, used when AEGIS_LLM=ollama
# OLLAMA_HOST=http://127.0.0.1:11434

# Paths. Override to point at a checkpoint or corpus outside the repo.
# AEGIS_ARTIFACTS=./ml/artifacts
# AEGIS_KNOWLEDGE_DIR=./services/api/knowledge
# AEGIS_TWIN_PATH=./ml/data/processed/transitions.json

# Transport & hardening.
# AEGIS_RATELIMIT=true
# Browser origins allowed to call this API, comma-separated (not JSON). The two
# defaults are Vite's dev server; add your deployed frontend's origin here. An
# explicit allow-list rather than `*`, because `*` and credentialed requests are
# not a combination any browser will honour.
# AEGIS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# AEGIS_FRAME_HZ=4
# AEGIS_MAX_UPLOAD_BYTES=4194304
# AEGIS_TOKEN_TTL=43200

# Which model a gate run is allowed to prove (task 1.7b). Off by default,
# because a clean clone has no checkpoint and the lexical model is the correct
# thing to serve there. Set it on a machine that has the weights:
# `AEGIS_REQUIRE_SERVING_BEST=1 make gates` fails instead of quietly proving the
# stand-in, which is how task 1.7 was ticked on a benign false positive.
# Report what is serving without requiring anything:
#   .venv/bin/python -m services.api.serving
# AEGIS_REQUIRE_SERVING_BEST=false

# ── Async job system (task 1.8) ─────────────────────────────────────────────
# Run investigations on a Celery worker when the broker above is reachable.
# On by default and self-degrading: with no Redis the graph runs in the API
# process exactly as it did before 1.8, tagged `queue:in_process` and reported
# under `execution` on /api/health. Set false to pin that behaviour.
# AEGIS_QUEUE=true
# Redeliveries before an investigation is dead-lettered onto aegis:inv:dlq.
# AEGIS_QUEUE_MAX_RETRIES=2
# How long a job taken by a worker stays invisible before the broker offers it
# to another one — i.e. how quickly a SIGKILLed worker's job is picked up again.
# Must stay LONGER than the slowest task, or a job still running is handed to a
# second worker. Celery's Redis default is 3600; 1800 clears the sandbox queue's
# stated budget of minutes with an order of magnitude spare.
# AEGIS_QUEUE_VISIBILITY_TIMEOUT=1800
